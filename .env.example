# Copy to .env.local for local development. Never commit real values.
# Every variable has a safe local default: with none set, the app runs on PGlite, local files,
# an email outbox folder, an inline job queue, stripe-mock and the mock voice engine.
# For production, fill the "Production" values in Vercel (Project > Settings > Environment Variables).

# ---------------------------------------------------------------- Site
# Public site URL for canonical links, Open Graph and the sitemap. Inlined at build time. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The app's own URL (auth callbacks, email links). Production: same as NEXT_PUBLIC_SITE_URL.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# API base shown in code samples (defaults to <site>/api).
NEXT_PUBLIC_API_BASE_URL=
# Company details for the Terms and Privacy Policy. Until set, the pages show [bracketed] placeholders.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_REG_NO=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_GOVERNING_LAW=
NEXT_PUBLIC_COURTS=

# ---------------------------------------------------------------- Database
# Local: `npm run db` starts PGlite on 127.0.0.1:5433. Production: Supabase > Connect > Transaction pooler URI.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Migrations only: Supabase > Connect > Direct connection URI (port 5432). Empty = DATABASE_URL.
MIGRATE_DATABASE_URL=
DATABASE_POOL_MAX=5
# 1 only for a direct (session) connection; keep 0 with the Supabase transaction pooler.
DATABASE_PREPARE=0

# ---------------------------------------------------------------- Auth (Better Auth)
# Production: a random 32+ character string (`openssl rand -base64 32`). The app refuses to start with the dev default.
BETTER_AUTH_SECRET=
# Optional "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "online" checks Have I Been Pwned (k-anonymity); "local" uses the bundled list.
BREACHED_PASSWORD_CHECK=local
# 32 random bytes, base64 (`openssl rand -base64 32`): encrypts webhook secrets at rest. Required in production.
APP_ENCRYPTION_KEY=
# Super-admin (platform Owner). `npm run admin:seed` creates this account on first deploy; the
# Owner then opens /admin/setup, enters ADMIN_SETUP_TOKEN once to choose a password, and must turn
# on two-factor sign-in before the admin console opens. (Signing up with this address and
# confirming the email also makes it the Owner.)
ADMIN_EMAIL=owner@example.com
# One-time setup token, at least 32 characters (`openssl rand -base64 32`). Works once.
ADMIN_SETUP_TOKEN=
# Optional: only these IPs or IPv4 CIDR ranges can open /admin, e.g. 203.0.113.7,198.51.100.0/24
ADMIN_IP_ALLOWLIST=

# ---------------------------------------------------------------- Storage
# local (files under MIMIX_DATA_DIR) or s3 (Supabase Storage S3 endpoint, or Cloudflare R2).
STORAGE_DRIVER=local
MIMIX_DATA_DIR=.data
# Signs media URLs. Production: a random 32+ character string. Required in production.
STORAGE_SIGNING_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN in front of signed media URLs.
MEDIA_CDN_URL=

# ---------------------------------------------------------------- Billing (Stripe)
# Local: run stripe-mock and set STRIPE_API_BASE=http://localhost:12111. Production: leave STRIPE_API_BASE empty.
STRIPE_API_BASE=
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_dev_only
# 1 to have Stripe Tax collect tax at checkout (needs tax registrations in Stripe).
STRIPE_AUTOMATIC_TAX=0

# ---------------------------------------------------------------- Email
# outbox (JSON files in .data/outbox) or resend.
EMAIL_DRIVER=outbox
EMAIL_FROM=Mimix <no-reply@example.com>
RESEND_API_KEY=
# Optional inbox that gets an alert for every abuse report.
SAFETY_EMAIL=
# Newsletter and contact forms: log (server log) in this build.
FORMS_DELIVERY=log

# ---------------------------------------------------------------- Jobs
# inline (in the web process; fine locally) or bullmq (Redis, with `npm run worker` running).
QUEUE_DRIVER=inline
REDIS_URL=redis://127.0.0.1:6379
CONCURRENCY=2
# Vercel Cron sends this to /api/cron/sweep every 10 minutes (vercel.json). 16+ characters. Unset = route off.
CRON_SECRET=
# ffmpeg binary for audio conversion. Empty = the bundled static build (works on Vercel). The worker
# container sets its own system ffmpeg.
FFMPEG_PATH=

# ---------------------------------------------------------------- Voice engine
# mock (no account, voice-like sound), inworld, voxcpm (our GPU server, engines/voxcpm) or kokoro
# (our CPU server, engines/kokoro, at MIXER_ENGINE_URL: real voices with no account; Start Mimix sets this up).
VOICE_ENGINE=mock
# With VOICE_ENGINE=kokoro: extras the Kokoro server runs (its own KOKORO_FEATURES): transcribe, isolate, clone
# (clone = voice cloning with OpenVoice v2 and the CAM++ consent check; it also needs transcribe).
KOKORO_FEATURES=
# Inworld: the API key exactly as the Inworld portal shows it (already base64).
INWORLD_API_KEY=
INWORLD_API_BASE=https://api.inworld.ai
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_STT_MODEL=inworld/inworld-stt-1
# Stock voices for library voices that have no Inworld voice of their own (lower / higher pitch).
INWORLD_VOICE_LOW=Dennis
INWORLD_VOICE_HIGH=Ashley
# VoxCPM2 server (see engines/voxcpm/README.md). The token must match the server's MIMIX_ENGINE_TOKEN.
SELF_HOSTED_ENGINE_URL=
SELF_HOSTED_ENGINE_TOKEN=
# Must match the server's FEATURES: any of stream, clone, design, transcribe, isolate.
SELF_HOSTED_FEATURES=stream,clone,design

# Voice Mixer engine: none (use the main engine's mixing; only the mock engine mixes) or kokoro
# (our Kokoro-82M server in engines/kokoro, runs on CPU). With kokoro, the Mixer's sources are the
# Kokoro library voices; mixing your own cloned voices comes later.
MIXER_ENGINE=none
MIXER_ENGINE_URL=
MIXER_ENGINE_TOKEN=
# After saving a Kokoro mix, clone it onto the main engine from a 30-second system-made reference
# (needs a main engine with instant cloning). Leave off until the engine's terms allow it.
MIX_CLONE_TO_MAIN=false
# Speaker check for consent recordings. `dsp` is a stand-in for the preview engine: with a real engine,
# cloning stays off. `neural` is 3D-Speaker's CAM++ model on the Kokoro server (KOKORO_FEATURES=clone).
SPEAKER_VERIFIER=dsp
# How a clone's consent is taken. `recording`: the speaker reads a random phrase that must match the
# samples (words and speaker). `attest`: no recording; the voice switches on from the uploader's ticked
# confirmation, kept as a consent record. The local launcher uses `attest`; keep `recording` for a
# public site until the lawyer clears it (launch checklist).
CLONE_CONSENT=recording
# The neural check's pass mark (0.2 to 0.95; empty = 0.5). "Tune voice check" writes it from your own recordings.
SPEAKER_MATCH=
SPEAKER_MATCH_TUNED=

# ---------------------------------------------------------------- Graphics-card engine (optional)
# off, chatterbox (Chatterbox Multilingual, 23 languages, engines/chatterbox) or voxcpm (VoxCPM2, 30 languages).
# Runs next to the main engine: clones are made there, and text in a language Kokoro doesn't speak is read there.
GPU_ENGINE=off
GPU_ENGINE_URL=
GPU_ENGINE_TOKEN=
GPU_ENGINE_FEATURES=clone

# ---------------------------------------------------------------- Dubbing translation
# mock tags each line with its language; google uses Cloud Translation Basic (v2).
TRANSLATOR=mock
GOOGLE_TRANSLATE_API_KEY=

# ---------------------------------------------------------------- Error monitoring (Sentry)
# Leave empty to turn monitoring off. Create a Next.js project in Sentry and copy its DSN into both.
# The DSN is not a secret (it only allows sending events), but keep it in env vars like the rest.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# production or staging (defaults to Vercel's environment name).
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Share of server requests traced for performance (0 to 1).
SENTRY_TRACES_SAMPLE_RATE=0.05

# ---------------------------------------------------------------- Tests
# 1 only in test runs: exposes /test-error (500 page check) and the /api/test/* helpers. Never in production.
ENABLE_TEST_ROUTES=0
